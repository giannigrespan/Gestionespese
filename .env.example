# Connessione Postgres (Vercel Postgres / Neon). Su Vercel viene iniettata
# automaticamente collegando un database dallo Storage tab del progetto.
DATABASE_URL="postgresql://user:password@host/db?sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://user:password@host/db?sslmode=require"

# Segreto per firmare i JWT di sessione: genera una stringa lunga e casuale
JWT_SECRET="change-me-to-a-long-random-string"
